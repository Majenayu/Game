{
  "name": "orb-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client",
    "e2e"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "build:zip": "npm run build -w client && node scripts/build-zip.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "npm run test -w e2e",
    "covers": "npm run covers -w e2e",
    "videos": "npm run videos -w e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/game-icons": "^1.2.4",
    "archiver": "^7.0.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  }
}
